# Optional: public URL of the separately hosted BIZORA Express backend.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Optional: public URL/base path for uploaded assets when they live on the backend/CDN.
# Example: https://api.example.com
VITE_ASSET_BASE_URL=

# GitHub Pages project path. The workflow sets this automatically from the repository name.
VITE_BASE_PATH=/bizora-website/
